        ax.spines["geo"].set_visible(False)
    except Exception:
        pass

    try:
        ax.set_xticks([])
        ax.set_yticks([])
    except Exception:
        pass

    ax.tick_params(
        axis="both",
        which="both",
        bottom=False,
        top=False,
        left=False,
        right=False,
        labelbottom=False,
        labeltop=False,
        labelleft=False,
        labelright=False,
        length=0,
        width=0,
    )

    try:
        ax.grid(
            False,
            which="both",
            axis="both",
        )
    except Exception:
        pass

    try:

