# =============================================================

def make_three_variable_seasonal_maps():

    # =========================================================
    # INPUT
    # =========================================================

    file_path = find_jules_file(
        suite_dir,
        file_name
    )

    print()
    print(
        "Suite directory:"
    )

    print(
        suite_dir
    )

    print()
    print(
        "Input file:"
    )

    print(
        file_path
    )

    # =========================================================
    # TIME
    # =========================================================

    (
        times,
        times_unit,
        times_long_name,
        times_dims
    ) = readJULES.read_jules_m2(
        file_path,
        "time"
    )

    times = dataOPS.ensure_np_datetime(
        times
    )

    year_indices = np.where(
        (
            times
            >=
            np.datetime64(
                f"{year}-01-01"
            )
        )
        &
        (
            times
            <
            np.datetime64(
                f"{year + 1}-01-01"
            )
        )
    )[0]

    if len(year_indices) == 0:

        raise ValueError(
            f"No time points found for {year}."
        )

    print()
    print(
        f"Found {len(year_indices)} "
        f"time points for {year}."
    )

    times_year = times[
        year_indices
    ]

    # =========================================================
    # HEADER
    # =========================================================

    header = readJULES.read_jules_header(
        file_path
    )

    (
        lat_string,
        lon_string,
        lat_key,
        lon_key,
        variable_keys,
    ) = identify_lat_lon(
        header
    )

    # =========================================================
    # CHECK VARIABLES
    # =========================================================

    print()
    print(
        "Requested variables:"
    )

    for display_name, variable_name in VARIABLES.items():

        print(
            f"  {display_name}: {variable_name}"
        )

        if variable_name not in variable_keys:

            raise ValueError(
                f"Variable '{variable_name}' "
                f"for '{display_name}' was not found.\n\n"
                f"Available variables:\n"
                +
                "\n".join(
                    f"  {v}"
                    for v in variable_keys
                )
            )

    # =========================================================
    # LAT/LON
    # =========================================================

    (
        lats,
        lats_units,
        lats_long_name,
        lats_dims
    ) = readJULES.read_jules_m2(
        file_path,
        lat_string
    )

    (
        lons,
        lons_units,
        lons_long_name,
        lons_dims
    ) = readJULES.read_jules_m2(
        file_path,
        lon_string
    )

    # =========================================================
    # GRID
    # =========================================================

    (
        lat_mask,
        lat_idx,
        lon_idx,
        lat2d,
        lon2d,
        Ny,
        Nx,
    ) = construct_grid(
        lats,
        lons,
        latitude_bounds
    )

    print()
    print(
        "Grid:",
        Ny,
        "x",
        Nx
    )

    # =========================================================
    # READ VARIABLES
    # =========================================================

    all_monthly_data = {}

    variable_metadata = {}

    for display_name, variable_name in VARIABLES.items():

        (
            gridded,
            variable_unit,
            variable_long_name,
            variable_dims
        ) = read_and_grid_variable(
            file_path,
            variable_name,
            lat_key,
            lon_key,
            lat_mask,
            lat_idx,
            lon_idx,
            Ny,
            Nx
        )

        # -----------------------------------------------------
        # Select only requested year
        # -----------------------------------------------------

        if "time" in variable_dims:

            spatial_names = {
                lat_key,
                lon_key
            }

            extra_dimension_names = [
                d
                for d in variable_dims
                if d not in spatial_names
            ]

            time_position = (
                extra_dimension_names.index(
                    "time"
                )
            )

            gridded = np.take(
                gridded,
                year_indices,
                axis=time_position
            )

            gridded_dims = [
                d
                for d in variable_dims
                if d not in spatial_names
            ] + [
                lat_key,
                lon_key
            ]

        else:

            gridded_dims = [
                d
                for d in variable_dims
                if d not in {
                    lat_key,
                    lon_key
                }
            ] + [
                lat_key,
                lon_key
            ]

        # =====================================================
        # MONTHLY EXTRACTION
        # =====================================================

        monthly_data = extract_monthly_maps(
            gridded,
            gridded_dims,
            times_year,
            MONTHS
        )

        all_monthly_data[
            display_name
        ] = monthly_data

        variable_metadata[
            display_name
        ] = {
            "unit": variable_unit,
            "long_name": variable_long_name,
            "variable_name": variable_name,
        }

    # =========================================================
    # CREATE THREE FIGURES
    # =========================================================

    figures = []

    for display_name in VARIABLES:

        info = variable_metadata[
            display_name
        ]

        fig = make_seasonal_panel(
            lat2d,
            lon2d,
            all_monthly_data[
                display_name
            ],
            display_name,
            info["unit"],
            info["long_name"]
        )

        figures.append(
            fig
        )

    # =========================================================
    # SHOW ONLY
    # =========================================================

    plt.show()


# =============================================================
# RUN
# =============================================================

if __name__ == "__main__":

    make_three_variable_seasonal_maps()
