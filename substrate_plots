# =============================================================
# ALPHA-BLENDED COLOURMAP
# =============================================================

def make_alpha_colormap(
        cmap_name):

    base_cmap = plt.get_cmap(
        cmap_name
    )

    N = 256

    colors = base_cmap(
        np.linspace(
            0,
            1,
            N
        )
    )

    colors[
        :,
        -1
    ] = np.linspace(
        0,
        1,
        N
    )

    return (
        mcolors.ListedColormap(
            colors
        )
    )


# =============================================================
# PLOT ONE MONTH
# =============================================================

def plot_month(
        ax,
        lat2d,
        lon2d,
        data,
        cmap_name,
        vmin,
        vmax):

    if data is None:

        return

    data = convert_to_numpy(
        data
    )

    while data.ndim > 2:

        data = np.nanmean(
            data,
            axis=0
        )

    if data.ndim != 2:

        raise ValueError(
            f"Expected 2D map but received "
            f"shape {data.shape}"
        )

    norm = mcolors.Normalize(
        vmin=vmin,
        vmax=vmax
    )

    alpha_cmap = make_alpha_colormap(
        cmap_name
    )

    rgba_colors = alpha_cmap(
        norm(data)
    )

    finite = np.isfinite(
        data
    )

    rgba_colors[
        ...,
        -1
    ] = np.where(
        finite,
        np.clip(
            norm(data),
            0,
            1
        ),
        0
    )

    ax.pcolormesh(
        lon2d,
        lat2d,
        rgba_colors,
        shading="nearest",
        antialiased=False,
        edgecolors="none",
        linewidth=0,
        rasterized=True,
        transform=ccrs.PlateCarree(),
        zorder=3
    )

    ax.add_feature(
        cfeature.OCEAN,
        facecolor="white",
        edgecolor="none",
        linewidth=0,
        zorder=6,
        alpha=1.0
    )


# =============================================================
# COLOURBAR
# =============================================================

def add_alpha_colorbar(
        fig,
        cmap_name,
        vmin,
        vmax,
        variable_unit):

    norm = mcolors.Normalize(
        vmin=vmin,
        vmax=vmax
    )

    alpha_cmap = make_alpha_colormap(
        cmap_name
    )

    sm = cm.ScalarMappable(
        cmap=alpha_cmap,
        norm=norm
    )

    sm.set_array([])

    # =========================================================
    # COMPACT COLOURBAR POSITION
    # =========================================================

    cbar_ax = fig.add_axes(
        [
            0.895,
            0.29,
            0.018,
            0.42
        ]
    )

    cbar_ax.add_patch(
        plt.Rectangle(
            (0, 0),
            1,
            1,
            transform=cbar_ax.transAxes,
            color="#f5e6c8",
            alpha=0.5,
            zorder=0
        )
    )

    cb = fig.colorbar(
        sm,
        cax=cbar_ax,
        orientation="vertical"
    )

    cb.set_label(
        dataOPS.cleanup_exponents(
            variable_unit
        ),
        fontsize=18,
        labelpad=12
    )

    cb.ax.tick_params(
        labelsize=13
    )

    return cb


# =============================================================
# SEASONAL PANEL
# =============================================================

def make_seasonal_panel(
        lat2d,
        lon2d,
        monthly_data,
        display_name,
        variable_unit,
        variable_long_name):

    print()
    print(
        "Creating panel:",
        display_name
    )

    # =========================================================
    # FINITE VALUES
    # =========================================================

    all_values = []

    for month in MONTHS:

        month_data = monthly_data.get(
            month
        )

        if month_data is None:
            continue

        month_data = convert_to_numpy(
            month_data
        )

        finite = month_data[
            np.isfinite(
                month_data
            )
        ]

        if finite.size:

            all_values.append(
                finite
            )

    if not all_values:

        raise ValueError(
            f"No finite data available for "
            f"{display_name}."
        )

    all_values = np.concatenate(
        all_values
    )

    vmin = np.nanmin(
        all_values
    )

    vmax = np.nanmax(
        all_values
    )

    if np.isclose(
        vmin,
        vmax
    ):

        vmax = vmin + 1.0

    print(
        display_name,
        "range:",
        vmin,
        "to",
        vmax
    )

    cmap_name = COLORMAPS[
        display_name
    ]

    # =========================================================
    # FIGURE
    # =========================================================
    #
    # Smaller figure than the previous version.
    # The panels occupy almost the entire canvas.
    #
    # =========================================================

    fig, axes = plt.subplots(
        2,
        2,
        figsize=(12, 6.4),
        subplot_kw={
            "projection": ccrs.PlateCarree(
                central_longitude=25
            )
        }
    )

    axes = axes.flatten()

    positions = {
        3: 0,
        6: 1,
        9: 2,
        12: 3,
    }

    # =========================================================
    # PLOT MONTHS
    # =========================================================

    for month in MONTHS:

        ax = axes[
            positions[month]
        ]

        setup_map(
            ax
        )

        plot_month(
            ax,
            lat2d,
            lon2d,
            monthly_data.get(month),
            cmap_name,
            vmin,
            vmax
        )

        ax.set_title(
            calendar.month_name[month],
            fontsize=18,
            fontstyle="italic",
            loc="center",
            pad=3
        )

        clean_map_axis(
            ax
        )

    # =========================================================
    # COLOURBAR
    # =========================================================

    add_alpha_colorbar(
        fig,
        cmap_name,
        vmin,
        vmax,
        variable_unit
    )

    # =========================================================
    # FIGURE TITLE
    # =========================================================

    fig.suptitle(
        display_name,
        fontsize=22,
        fontstyle="italic",
        x=0.47,
        y=0.985
    )

    # =========================================================
    # TIGHT LAYOUT
    # =========================================================

    plt.subplots_adjust(
        left=0.015,
        right=0.875,
        top=0.91,
        bottom=0.025,
        wspace=0.005,
        hspace=0.015
    )

    # =========================================================
    # FINAL CLEAN
    # =========================================================

    for ax in axes:

        clean_map_axis(
            ax
        )

    return fig


# =============================================================
