def find_jules_file(
        suite_dir,
        file_name):

    path = os.path.join(
        suite_dir,
        file_name
    )

    if os.path.isfile(path):

        return path

    raise FileNotFoundError(
        f"Could not find JULES file:\n{path}"
    )


# =============================================================
# IDENTIFY LAT/LON
# =============================================================

def identify_lat_lon(header):

    dimension_keys = list(header[0])
    variable_keys = list(header[1])

    if (
        "latitude" in variable_keys
        and
        "longitude" in variable_keys
    ):

        lat_string = "latitude"
        lon_string = "longitude"

    elif (
        "lat" in variable_keys
        and
        "lon" in variable_keys
    ):

        lat_string = "lat"
        lon_string = "lon"

    else:

        raise ValueError(
            "Could not identify latitude/longitude variables.\n"
            f"Variables found: {variable_keys}"
        )

    if (
        "lat" in dimension_keys
        and
        "lon" in dimension_keys
    ):

        lat_key = "lat"
        lon_key = "lon"

    elif (
        "y" in dimension_keys
        and
        "x" in dimension_keys
    ):

        lat_key = "y"
        lon_key = "x"

    else:

        raise ValueError(
            "Could not identify latitude/longitude dimensions.\n"
            f"Dimensions found: {dimension_keys}"
        )

    return (
        lat_string,
        lon_string,
        lat_key,
        lon_key,
        variable_keys,
    )


# =============================================================
# CONSTRUCT GRID
# =============================================================

def construct_grid(
        lats,
        lons,
        latitude_bounds=None):

    lats_flat_full = np.asarray(
        lats
    ).flatten()

    lons_flat_full = np.asarray(
        lons
    ).flatten()

    if lats_flat_full.size != lons_flat_full.size:

        raise ValueError(
            "Latitude and longitude arrays contain "
            "different numbers of points."
        )

    if latitude_bounds is not None:

        lat_min, lat_max = latitude_bounds

        lat_mask = (
            (lats_flat_full >= lat_min)
            &
            (lats_flat_full <= lat_max)
        )

        if not np.any(lat_mask):

            raise ValueError(
                f"No latitude points found between "
                f"{lat_min} and {lat_max}"
            )

    else:

        lat_mask = np.ones(
            lats_flat_full.shape,
            dtype=bool
        )

    lats_flat = (
        lats_flat_full[
            lat_mask
        ]
    )

    lons_flat = (
        lons_flat_full[
            lat_mask
        ]
    )

    lats_unique = np.sort(
        np.unique(
            lats_flat
        )
    )

    lons_unique = np.sort(
        np.unique(
            lons_flat
        )
    )

    if len(lats_unique) < 2:

        raise ValueError(
            "Not enough unique latitude points "
            "to construct a grid."
        )

    if len(lons_unique) < 2:

        raise ValueError(
            "Not enough unique longitude points "
            "to construct a grid."
        )

    dlat = np.median(
        np.diff(
            lats_unique
        )
    )

    dlon = np.median(
        np.diff(
            lons_unique
        )
    )

    if dlat <= 0 or dlon <= 0:

        raise ValueError(
            "Could not determine positive grid spacing."
        )

    lat_grid = np.arange(
        lats_unique.min(),
        lats_unique.max() + dlat / 2,
        dlat
    )

    lon_grid = np.arange(
        lons_unique.min(),
        lons_unique.max() + dlon / 2,
        dlon
    )

    Ny = len(
        lat_grid
    )

    Nx = len(
        lon_grid
    )

    lat_idx = (
        (
            lats_flat
            -
            lat_grid[0]
        )
        /
        dlat
    ).round().astype(int)

    lon_idx = (
        (
            lons_flat
            -
            lon_grid[0]
        )
        /
        dlon
    ).round().astype(int)

    if (
        np.any(lat_idx < 0)
        or
        np.any(lat_idx >= Ny)
    ):

        raise ValueError(
            "Latitude indices fall outside inferred grid."
        )

    if (
        np.any(lon_idx < 0)
        or
        np.any(lon_idx >= Nx)
    ):

        raise ValueError(
            "Longitude indices fall outside inferred grid."
        )

    lat2d, lon2d = np.meshgrid(
        lat_grid,
        lon_grid,
        indexing="ij"
    )

    return (
        lat_mask,
        lat_idx,
        lon_idx,
        lat2d,
        lon2d,
        Ny,
        Nx,
    )


# =============================================================
# CONVERT TO NUMPY
# =============================================================

def convert_to_numpy(
        variable_array):

    if isinstance(
        variable_array,
        np.ndarray
    ):

        return variable_array

    if isinstance(
        variable_array,
        np.ma.MaskedArray
    ):

        return np.asarray(
            variable_array.filled(
                np.nan
            )
        )

    for attribute in (
        "data",
        "values",
        "array",
        "value",
    ):

        if hasattr(
            variable_array,
            attribute
        ):

            candidate = getattr(
                variable_array,
                attribute
            )

            try:

                candidate = (
                    candidate()
                    if callable(candidate)
                    else candidate
                )

                return np.asarray(
                    candidate
                )

            except Exception:
                pass

    try:

        return np.asarray(
            variable_array
        )

    except Exception as exc:

        raise TypeError(
            "Could not convert variable returned by "
            "readJULES.read_jules_m2() to a numpy array.\n"
            f"Object type: {type(variable_array)}"
        ) from exc


# =============================================================
# READ AND GRID VARIABLE
# =============================================================

def read_and_grid_variable(
        file_path,
        variable_name,
        lat_key,
        lon_key,
        lat_mask,
        lat_idx,
        lon_idx,
        Ny,
        Nx):

    print()
    print(
        f"Reading variable: {variable_name}"
    )

    (
        variable_array,
        variable_unit,
        variable_long_name,
        variable_dims
    ) = readJULES.read_jules_m2(
        file_path,
        variable_name
    )

    variable_array = convert_to_numpy(
        variable_array
    )

    variable_array = (
        dataOPS.sanitize_extreme_values(
            variable_array
        )
    )

    variable_array = convert_to_numpy(
        variable_array
    )

    print(
        "Original shape:",
        variable_array.shape
    )

    print(
        "Dimensions:",
        variable_dims
    )

    lat_axis = (
        variable_dims.index(
            lat_key
        )
        if lat_key in variable_dims
        else None
    )

    lon_axis = (
        variable_dims.index(
            lon_key
        )
        if lon_key in variable_dims
        else None
    )

    if lat_axis is None:

        raise ValueError(
            f"Could not find latitude dimension "
            f"'{lat_key}' in {variable_dims}"
        )

    if lon_axis is None:

        raise ValueError(
            f"Could not find longitude dimension "
            f"'{lon_key}' in {variable_dims}"
        )

    other_axes = [
        i
        for i in range(
            variable_array.ndim
        )
        if i not in (
            lat_axis,
            lon_axis
        )
    ]

    transpose_order = (
        other_axes
        +
        [
            lat_axis,
            lon_axis
        ]
    )

    variable_array = np.transpose(
        variable_array,
        axes=transpose_order
    )

    print(
        "Reordered shape:",
        variable_array.shape
    )

    n_spatial = (
        variable_array.shape[-2]
        *
        variable_array.shape[-1]
    )

    expected_spatial = (
        lat_mask.size
    )

    if n_spatial != expected_spatial:

        raise ValueError(
            f"Mismatch for {variable_name}:\n"
            f"  Variable spatial points = {n_spatial}\n"
            f"  Coordinate points = {expected_spatial}\n"
            f"  Variable shape = {variable_array.shape}"
        )

    extra_shape = (
        variable_array.shape[:-2]
    )

    gridded = np.full(
        extra_shape + (
            Ny,
            Nx
        ),
        np.nan,
        dtype=float
    )

    if extra_shape:

        iterator = np.ndindex(
            extra_shape
        )

    else:

        iterator = [
            ()
        ]

    for idx in iterator:

        values = variable_array[
            idx
        ].flatten()

        if values.size != lat_mask.size:

            raise ValueError(
                f"Spatial mismatch for {variable_name}.\n"
                f"  Values: {values.size}\n"
                f"  Coordinates: {lat_mask.size}"
            )

        values = values[
            lat_mask
        ]

        gridded[
            idx
            +
            (
                lat_idx,
                lon_idx
            )
        ] = values

    print(
        "Gridded shape:",
        gridded.shape
    )

    return (
        gridded,
        variable_unit,
        variable_long_name,
        variable_dims,
    )


# =============================================================
# EXTRACT MONTHLY DATA
# =============================================================

def extract_monthly_maps(
        gridded,
        variable_dims,
        times,
        requested_months):

    gridded = convert_to_numpy(
        gridded
    )

    if gridded.ndim == 2:

        return {
            month: np.array(
                gridded,
                dtype=float,
                copy=True
            )
            for month in requested_months
        }

    time_axis = None

    if "time" in variable_dims:

        original_time_axis = variable_dims.index(
            "time"
        )

        spatial_axes = [
            variable_dims.index("lat")
            if "lat" in variable_dims
            else variable_dims.index("y")
            if "y" in variable_dims
            else None,

            variable_dims.index("lon")
            if "lon" in variable_dims
            else variable_dims.index("x")
            if "x" in variable_dims
            else None,
        ]

        other_axes_original = [
            i
            for i in range(
                len(variable_dims)
            )
            if i not in spatial_axes
        ]

        if original_time_axis in other_axes_original:

            time_axis = (
                other_axes_original.index(
                    original_time_axis
                )
            )

    if time_axis is None:

        time_axis = 0

    times = dataOPS.ensure_np_datetime(
        times
    )

    monthly = {}

    for month in requested_months:

        month_indices = np.where(
            (
                np.array(
                    [
                        t.astype(
                            "datetime64[M]"
                        )
                        for t in times
                    ]
                )
                ==
                np.datetime64(
                    f"{year}-{month:02d}"
                )
            )
        )[0]

        if len(month_indices) == 0:

            print(
                f"WARNING: No data found for "
                f"{calendar.month_name[month]}."
            )

            monthly[
                month
            ] = None

            continue

        selected = np.take(
            gridded,
            month_indices,
            axis=time_axis
        )

        if selected.ndim > 3:

            selected = np.nanmean(
                selected,
                axis=tuple(
                    range(
                        0,
                        selected.ndim - 2
                    )
                )
            )

        elif selected.ndim == 3:

            selected = np.nanmean(
                selected,
                axis=0
            )

        monthly[
            month
        ] = selected

        print(
            f"{calendar.month_name[month]}:",
            len(month_indices),
            "time points"
        )

    return monthly


