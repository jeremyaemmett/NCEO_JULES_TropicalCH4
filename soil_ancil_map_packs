# ============================================================
# AFRICA-ONLY COUNTRY GEOMETRY
# ============================================================

def make_africa_geometry():

    print(
        "Loading Natural Earth African countries..."
    )

    shpfilename = shpreader.natural_earth(
        resolution="50m",
        category="cultural",
        name="admin_0_countries"
    )

    reader = shpreader.Reader(
        shpfilename
    )

    africa_geometries = []

    for record in reader.records():

        continent = record.attributes.get(
            "CONTINENT"
        )

        if continent != "Africa":
            continue

        geom = record.geometry

        minx, miny, maxx, maxy = (
            geom.bounds
        )

        if (
            maxx < LON_MIN
            or minx > LON_MAX
            or maxy < LAT_MIN
            or miny > LAT_MAX
        ):
            continue

        africa_geometries.append(
            geom
        )

    if not africa_geometries:

        raise RuntimeError(
            "No African geometries were found."
        )

    return unary_union(
        africa_geometries
    )


