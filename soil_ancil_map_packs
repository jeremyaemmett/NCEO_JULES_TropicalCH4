# ============================================================
# BUILD AFRICA LAND MASK
# ============================================================

def make_africa_mask(
    lon,
    lat
):

    Lon, Lat = np.meshgrid(
        lon,
        lat
    )

    points = np.column_stack(
        [
            Lon.ravel(),
            Lat.ravel()
        ]
    )

    mask = np.array(
        [
            africa_prepared.contains(
                Point(x, y)
            )
            for x, y in points
        ],
        dtype=bool
    )

    return mask.reshape(
        Lon.shape
    )


