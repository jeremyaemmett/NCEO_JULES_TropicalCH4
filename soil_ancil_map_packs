# ============================================================
# SLAB EDGE
# ============================================================

def make_slab_edge(
    image
):

    edge = Image.new(
        "RGBA",
        image.size,
        (
            0,
            0,
            0,
            0
        )
    )

    dark = image.copy()

    rgba = np.array(
        dark
    )

    rgba[..., 0] = (
        rgba[..., 0] * 0.42
    ).astype(
        np.uint8
    )

    rgba[..., 1] = (
        rgba[..., 1] * 0.42
    ).astype(
        np.uint8
    )

    rgba[..., 2] = (
        rgba[..., 2] * 0.42
    ).astype(
        np.uint8
    )

    dark = Image.fromarray(
        rgba,
        "RGBA"
    )

    for n in range(
        SLAB_THICKNESS,
        0,
        -1
    ):

        edge.alpha_composite(
            dark,
            (
                n * SLAB_DX
                // SLAB_THICKNESS,

                n * SLAB_DY
                // SLAB_THICKNESS
            )
        )

    return edge


