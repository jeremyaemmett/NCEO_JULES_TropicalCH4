    lat2, lon2 = latlon(da2)

    lats1 = da1[lat1].values
    lons1 = da1[lon1].values

    lats2 = da2[lat2].values
    lons2 = da2[lon2].values

    grid_match = (
        np.array_equal(lats1, lats2)
        and
        np.array_equal(lons1, lons2)
    )

    if grid_match:

        da2r = da2

    else:

        print(
            "  interpolating..."
        )

        da2r = da2.interp(
            {
                lat2: lats1,
                lon2: lons1
            }
        )

    diff = da2r - da1

    values = diff.values

    finite = np.isfinite(values)

    if np.any(finite):

        mean_abs_diff = np.mean(
            np.abs(
                values[finite]
            )
        )

    else:

        mean_abs_diff = np.nan

    results.append(
        {
            "v1": v1,
            "v2": v2,
            "da1": da1,
            "da2": da2r,
            "diff": diff,
            "mean_abs_diff": mean_abs_diff
        }
    )


