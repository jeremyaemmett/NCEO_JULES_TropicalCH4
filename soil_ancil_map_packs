# ============================================================
# HELPERS
# ============================================================

def to_2d(da):

    for d in list(da.dims):

        if d.lower() in [
            "time",
            "t",
            "lev",
            "level",
            "z",
            "height"
        ]:

            da = da.isel(
                {d: 0}
            )

    while da.ndim > 2:

        da = da.isel(
            {da.dims[0]: 0}
        )

    return da


def latlon(da):

    lat = next(
        d for d in da.dims
        if "lat" in d.lower()
    )

    lon = next(
        d for d in da.dims
        if "lon" in d.lower()
    )

    return lat, lon


# ============================================================
# NORMALIZE LONGITUDE
# ============================================================

def normalize_longitude(da):

    lat_dim, lon_dim = latlon(da)

    lon = da[lon_dim]

    if float(lon.max()) > 180:

        new_lon = (
            ((lon + 180) % 360) - 180
        )

        da = da.assign_coords(
            {lon_dim: new_lon}
        )

        da = da.sortby(
            lon_dim
        )

    return da


# ============================================================
# CROP
# ============================================================

def crop_data(da):

    da = normalize_longitude(da)

    lat_dim, lon_dim = latlon(da)

    lat = da[lat_dim]
    lon = da[lon_dim]

    return da.sel(
        {
            lat_dim: (
                (lat >= LAT_MIN)
                &
                (lat <= LAT_MAX)
            ),

            lon_dim: (
                (lon >= LON_MIN)
                &
                (lon <= LON_MAX)
            )
        }
    )


# ============================================================
