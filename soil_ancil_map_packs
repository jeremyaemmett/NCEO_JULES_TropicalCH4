# ============================================================
# FADED COLORMAP
# ============================================================

def make_faded_colormap(
    cmap_name,
    fade
):

    fade = np.clip(
        fade,
        0.0,
        1.0
    )

    base_cmap = plt.get_cmap(
        cmap_name
    )

    colors = base_cmap(
        np.linspace(
            0,
            1,
            256
        )
    )

    # --------------------------------------------------------
    # Blend RGB channels toward white.
    #
    # fade = 0 -> original
    # fade = 1 -> white
    # --------------------------------------------------------

    colors[:, :3] = (
        colors[:, :3] * (1.0 - fade)
        +
        1.0 * fade
    )

    faded_cmap = (
        plt.matplotlib.colors.ListedColormap(
            colors
        )
    )

    faded_cmap.set_bad(
        alpha=0
    )

    return faded_cmap


# ============================================================
# RENDER MAP
# ============================================================

def render_map(
    da,
    cmap_name,
    vmin,
    vmax
):

    lat_dim, lon_dim = latlon(
        da
    )

    lat = da[lat_dim].values
    lon = da[lon_dim].values

    data = da.values.astype(
        float
    )

    fig = plt.figure(
        figsize=(12, 5),
        dpi=MAP_DPI,
        facecolor="none"
    )

    ax = fig.add_axes(
        [0, 0, 1, 1],
        projection=PROJECTION
    )

    ax.set_extent(
        [
            LON_MIN,
            LON_MAX,
            LAT_MIN,
            LAT_MAX
        ],
        crs=DATA_CRS
    )

    ax.patch.set_alpha(0)

    # --------------------------------------------------------
    # FADED COLORMAP
    # --------------------------------------------------------

    cmap = make_faded_colormap(
        cmap_name,
        COLOR_FADE
    )

    norm = plt.Normalize(
        vmin=vmin,
        vmax=vmax
    )

    # --------------------------------------------------------
    # RASTER
    # --------------------------------------------------------

    mesh = ax.pcolormesh(
        lon,
        lat,
        data,
        transform=DATA_CRS,
        cmap=cmap,
        norm=norm,
        shading="nearest",
        rasterized=True,
        antialiased=False,
        zorder=1
    )

    # --------------------------------------------------------
    # AFRICA-ONLY CLIP
    # --------------------------------------------------------

    clip_transform = (
        DATA_CRS._as_mpl_transform(
            ax
        )
    )

    clip_patch = PathPatch(
        africa_clip_path,
        transform=clip_transform,
        facecolor="none",
        edgecolor="none"
    )

    ax.add_patch(
        clip_patch
    )

    mesh.set_clip_path(
        clip_patch
    )

    # --------------------------------------------------------
    # AFRICA COASTLINE
    # --------------------------------------------------------

    ax.add_geometries(
        [africa_geometry],
        crs=DATA_CRS,
        facecolor="none",
        edgecolor="gray",
        linewidth=2.0,
        antialiased=True,
        zorder=10
    )

    # --------------------------------------------------------
    # REMOVE MAP FRAME
    # --------------------------------------------------------

    ax.spines["geo"].set_visible(
        False
    )

    # --------------------------------------------------------
    # SAVE TRANSPARENT MAP
    # --------------------------------------------------------

    buffer = io.BytesIO()

    fig.savefig(
        buffer,
        format="png",
        dpi=MAP_DPI,
        transparent=True,
        facecolor="none",
        edgecolor="none",
        pad_inches=0
    )

    plt.close(
        fig
    )

    buffer.seek(0)

    image = Image.open(
        buffer
    ).convert(
        "RGBA"
    )

    return image


