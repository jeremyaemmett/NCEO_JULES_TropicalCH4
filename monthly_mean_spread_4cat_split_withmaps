# =========================================================
# THREE SUBSTRATE Q10 COLORBARS
# =========================================================
#
# ONLY Q10 = 2, 3, 4.
#
# Q10 = 1 DOES NOT EXIST IN THIS COLORBAR.
# =========================================================

def create_substrate_q10_colorbar(
    fig,
    substrate,
    left,
    bottom,
    width,
    height,
    show_q10_labels=False
):

    base_rgb = np.array(
        to_rgba(
            color_map[substrate]
        )[:3]
    )

    # =====================================================
    # Q10 VALUES: 2, 3, 4 ONLY
    # =====================================================

    q10_positions = np.array(
        [
            2.0,
            3.0,
            4.0
        ]
    )

    q10_alpha_values = np.array(
        [
            q10_alpha["2"],
            q10_alpha["3"],
            q10_alpha["4"]
        ]
    )

    n = 256

    q10_dense = np.linspace(
        2.0,
        4.0,
        n
    )

    alpha_dense = np.interp(
        q10_dense,
        q10_positions,
        q10_alpha_values
    )

    # =====================================================
    # WASH COLOUR TOWARD WHITE
    # =====================================================

    WASH_FACTOR=0.7

    white_rgb = np.ones(3)

    washed_rgb = (
        WASH_FACTOR
        * alpha_dense[:, np.newaxis]
        * base_rgb
        +
        (
            1.0
            -
            WASH_FACTOR * alpha_dense[:, np.newaxis]
        )
        * white_rgb
    )

    rgba_table = np.ones(
        (
            n,
            4
        )
    )

    rgba_table[:, :3] = washed_rgb

    # Fully opaque colourbar
    rgba_table[:, 3] = 1.0


    cmap = LinearSegmentedColormap.from_list(
        f"q10_{substrate}",
        rgba_table
    )

    # =====================================================
    # COLORBAR NOW RUNS FROM Q10=2 TO Q10=4
    # =====================================================

    norm = Normalize(
        vmin=2.0,
        vmax=4.0
    )

    mappable = ScalarMappable(
        norm=norm,
        cmap=cmap
    )

    mappable.set_array(
        np.array(
            [
                2.0,
                4.0
            ]
        )
    )

    cax = fig.add_axes(
        [
            left,
            bottom,
            width,
            height
        ]
    )

    cbar = fig.colorbar(
        mappable,
        cax=cax,
        orientation="vertical"
    )

    # =====================================================
    # ONLY 2, 3, 4 TICKS
    # =====================================================

    cbar.set_ticks(
        [
            2.0,
            3.0,
            4.0
        ]
    )

    if show_q10_labels:

        cbar.set_ticklabels(
            [
                "2.0",
                "3.0",
                "4.0"
            ]
        )

        cbar.ax.tick_params(
            axis="y",
            which="both",
            length=3,
            width=0.7,
            labelsize=8,
            pad=2
        )

    else:

        cbar.ax.set_yticklabels([])

        cbar.ax.tick_params(
            axis="y",
            which="both",
            length=0
        )

    cbar.outline.set_linewidth(
        0.5
    )

    cbar.ax.set_xlabel(
        substrate_labels[substrate],
        fontsize=10,
        labelpad=8,
        rotation=45
    )

    cbar.ax.set_ylabel(
        "Q10",
        fontsize=9,
        labelpad=4
    )

    # =====================================================
    # MARK SELECTED Q10 = 2.0
    # =====================================================

    Q10_MARKER = 2.0

    cbar.ax.plot(
        0.5,
        Q10_MARKER,
        marker="s",
        markersize=Q10_MARKER_SIZE,
        markerfacecolor=color_map[substrate],
        markeredgecolor="black",
        markeredgewidth=Q10_MARKER_LINEWIDTH,
        linestyle="none",
        transform=cbar.ax.get_yaxis_transform(),
        clip_on=False,
        zorder=20,
        alpha=0.7
    )

    return cbar


