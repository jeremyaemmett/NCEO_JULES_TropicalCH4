def add_map_colorbar(fig):

    norm = mcolors.Normalize(
        vmin=MAP_VMIN,
        vmax=MAP_VMAX
    )

    cmap = plt.get_cmap(
        MAP_CMAP
    )

    N = 256

    values = np.linspace(
        0.0,
        1.0,
        N
    )

    colors = cmap(
        values
    )

    colors[:, -1] = values

    alpha_cmap = mcolors.ListedColormap(
        colors
    )

    sm = cm.ScalarMappable(
        cmap=alpha_cmap,
        norm=norm
    )

    sm.set_array([])

    cb_ax = fig.add_axes(
        [
            0.93,
            0.53,
            0.012,
            0.15
        ]
    )

    cb_ax.set_facecolor(
        "none"
    )

    cb = fig.colorbar(
        sm,
        cax=cb_ax,
        orientation="vertical"
    )

    cb.set_label(
        variable,
        fontsize=8
    )

    cb.ax.tick_params(
        labelsize=8
    )

    cb.outline.set_linewidth(
        0.6
    )

    return cb


