def add_panel_maps(
    fig,
    panel_ax,
    panel_key,
    row_bottom
):

    panel_bbox = panel_ax.get_position()

    panel_left = panel_bbox.x0
    panel_width = panel_bbox.width

    plot_bottom = panel_bbox.y0 - 0.05

    cluster_top = (
        plot_bottom
        - PLOT_TO_MAP_GAP
    )

    cluster_width = (
        panel_width
        * MAP_CLUSTER_WIDTH_FACTOR
    )

    CLUSTER_SIDE_SHIFT = 0.01

    if panel_left < 0.5:

        cluster_left = (
            panel_left
            - (
                cluster_width
                - panel_width
            ) / 2.0
            - CLUSTER_SIDE_SHIFT
        )

    else:

        cluster_left = (
            panel_left
            - (
                cluster_width
                - panel_width
            ) / 2.0
            + CLUSTER_SIDE_SHIFT
        )

    map_width = (
        cluster_width
        / 2.0
    )

    geographic_height_limit = (
        map_width
        * 0.31
    )

    map_height = (
        geographic_height_limit
    )

    map_step = (
        map_height
        + MAP_GAP_Y
    )

    cluster_height = (
        3.0 * map_height
        + 2.0 * MAP_GAP_Y
    )

    cluster_bottom = (
        cluster_top
        - cluster_height
    )

    month_positions = {
        "Mar": 0,
        "Sep": 1
    }

    substrate_positions = {
        "1": 0,
        "2": 1,
        "0": 2
    }

    map_axes = {}

    for substrate in substrates:

        map_axes[substrate] = {}

        map_row = substrate_positions[
            substrate
        ]

        for month in MAP_MONTHS:

            col = month_positions[
                month
            ]

            left = (
                cluster_left
                + col * map_width
            )

            bottom = (
                cluster_top
                - map_height
                - map_row * map_step
            )

            map_title = (
                month
                if map_row == 0
                else ""
            )

            ax = fig.add_axes(
                [
                    left,
                    bottom,
                    map_width,
                    map_height
                ],
                projection=ccrs.PlateCarree(
                    central_longitude=0
                )
            )

            map_axes[
                substrate
            ][month] = ax

            configure_map_axis(
                ax,
                map_title,
                substrate,
                SELECTED_Q10_CODE
            )

            map_info = selected_maps[
                panel_key
            ][substrate][month]

            data = map_info[
                "data"
            ]

            lat2d = map_info[
                "lat2d"
            ]

            lon2d = map_info[
                "lon2d"
            ]

            rgba, _, _ = make_absolute_rgba(
                data
            )

            if (
                lon2d.min()
                < MAP_LON_MIN - 1e-8
                or
                lon2d.max()
                > MAP_LON_MAX + 1e-8
            ):

                raise RuntimeError(
                    "\nMAP DATA PASSED TO PCOLORMESH "
                    "OUTSIDE REQUESTED LONGITUDE RANGE\n"
                    f"Longitude received: "
                    f"{lon2d.min()} to {lon2d.max()}\n"
                    f"Required: "
                    f"{MAP_LON_MIN} to {MAP_LON_MAX}"
                )

            ax.pcolormesh(
                lon2d,
                lat2d,
                rgba,
                shading="auto",
                transform=ccrs.PlateCarree(),
                linewidth=0,
                edgecolors="none",
                antialiased=False,
                zorder=2
            )

            add_coloured_coastline(
                ax,
                substrate
            )

    # =====================================================
    # BLACK RECTANGLES AROUND MAP CLUSTERS
    # =====================================================

    MAP_BOX_LINEWIDTH = 0.8

    MAP_BOX_PAD = 0.0025

    for month in MAP_MONTHS:

        month_axes = [
            map_axes[substrate][month]
            for substrate in substrates
        ]

        positions = [
            ax.get_position()
            for ax in month_axes
        ]

        left = min(
            pos.x0
            for pos in positions
        )

        right = max(
            pos.x1
            for pos in positions
        )

        bottom = min(
            pos.y0
            for pos in positions
        )

        top = max(
            pos.y1
            for pos in positions
        )

        rect = Rectangle(
            (
                left - MAP_BOX_PAD,
                bottom - MAP_BOX_PAD
            ),
            (
                right
                - left
                + 2 * MAP_BOX_PAD
            ),
            (
                top
                - bottom
                + 2 * MAP_BOX_PAD
            ),
            transform=fig.transFigure,
            facecolor="none",
            edgecolor="black",
            linewidth=MAP_BOX_LINEWIDTH,
            zorder=1000,
            clip_on=False
        )

        fig.add_artist(
            rect
        )

    return map_axes


