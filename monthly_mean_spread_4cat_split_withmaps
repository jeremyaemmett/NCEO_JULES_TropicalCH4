def find_netcdf(base):

    base = Path(base)

    extensions = [
        "*.nc",
        "*.nc4",
        "*.netcdf",
    ]

    matches = []

    for pattern in extensions:

        matches.extend(
            base.rglob(pattern)
        )

    if not matches:

        raise FileNotFoundError(
            f"No NetCDF file found under:\n{base}"
        )

    matches = sorted(
        set(matches)
    )

    return matches[0]


