def get_latlon(file_path):

    file_path = str(file_path)

    header = readJULES.read_jules_header(
        file_path
    )

    keys = list(header[1])

    lat_k = (
        "latitude"
        if "latitude" in keys
        else "lat"
    )

    lon_k = (
        "longitude"
        if "longitude" in keys
        else "lon"
    )

    lats, _, _, _ = readJULES.read_jules_m2(
        file_path,
        lat_k
    )

    lons, _, _, _ = readJULES.read_jules_m2(
        file_path,
        lon_k
    )

    lats = np.asarray(
        lats,
        dtype=float
    ).flatten()

    lons = np.asarray(
        lons,
        dtype=float
    ).flatten()

    lat_u = np.sort(
        np.unique(lats)
    )

    lon_u = np.sort(
        np.unique(lons)
    )

    if len(lat_u) < 2:
        raise RuntimeError(
            "Could not construct latitude grid."
        )

    if len(lon_u) < 2:
        raise RuntimeError(
            "Could not construct longitude grid."
        )

    dlat = np.median(
        np.diff(lat_u)
    )

    dlon = np.median(
        np.diff(lon_u)
    )

    lat_grid = np.arange(
        lat_u.min(),
        lat_u.max() + dlat * 0.5,
        dlat
    )

    lon_grid = np.arange(
        lon_u.min(),
        lon_u.max() + dlon * 0.5,
        dlon
    )

    return np.meshgrid(
        lat_grid,
        lon_grid,
        indexing="ij"
    )


