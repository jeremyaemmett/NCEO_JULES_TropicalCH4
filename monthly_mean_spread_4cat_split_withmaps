def get_map_file(
    suite,
    month
):

    root = get_map_directory(
        suite
    )

    if not root.exists():

        raise FileNotFoundError(
            f"\nMap directory does not exist:\n"
            f"{root}\n"
        )

    matches = sorted(
        root.rglob(
            f"*{month}_map.txt"
        )
    )

    if not matches:

        raise FileNotFoundError(
            f"\nCould not find a {month} map file.\n"
            f"Suite: {suite}\n"
            f"Root : {root}\n"
        )

    if len(matches) > 1:

        print(
            f"\nMultiple {month} map files found "
            f"for {suite}:"
        )

        for match in matches:
            print(
                f"  {match}"
            )

        print(
            "Using:"
        )

        print(
            f"  {matches[0]}"
        )

    else:

        print(
            f"\nFound {month} map:"
        )

        print(
            f"  Suite: {suite}"
        )

        print(
            f"  File : {matches[0]}"
        )

    return matches[0]


