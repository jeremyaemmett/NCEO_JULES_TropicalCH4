def plot_smooth_q10_band(
    ax,
    x,
    q10_data,
    color,
    alpha_map,
    y_axis_min,
    y_axis_max,
    zorder=1
):

    # =====================================================
    # HARD EXCLUSION OF Q10 = 1
    # =====================================================

    q10_data = {
        str(q): value
        for q, value in q10_data.items()
        if str(q) not in EXCLUDED_Q10_CODES
        and str(q) in ALLOWED_Q10_CODES
    }

    q10_codes = sorted(
        q10_data.keys(),
        key=lambda q: int(q)
    )

    if len(q10_codes) < 2:
        return

    y_values = np.array(
        [
            q10_data[q]
            for q in q10_codes
        ],
        dtype=float
    )

    alpha_values = np.array(
        [
            alpha_map[q]
            for q in q10_codes
        ],
        dtype=float
    )

    n_x = max(
        2400,
        series_length * 250
    )

    x_fine = np.linspace(
        x[0],
        x[-1],
        n_x
    )

    y_fine = np.empty(
        (
            len(q10_codes),
            n_x
        ),
        dtype=float
    )

    for i in range(len(q10_codes)):

        y_fine[i] = np.interp(
            x_fine,
            x,
            y_values[i]
        )

    n_y = 1800

    y_grid = np.linspace(
        y_axis_min,
        y_axis_max,
        n_y
    )

    alpha_field = np.zeros(
        (
            n_y,
            n_x
        ),
        dtype=np.float32
    )

    for j in range(n_x):

        column_y = y_fine[:, j]

        order = np.argsort(
            column_y
        )

        y_sorted = column_y[order]

        alpha_sorted = alpha_values[order]

        y_unique, unique_indices = np.unique(
            y_sorted,
            return_index=True
        )

        alpha_unique = alpha_sorted[
            unique_indices
        ]

        if len(y_unique) < 2:
            continue

        inside = (
            (y_grid >= y_unique[0])
            &
            (y_grid <= y_unique[-1])
        )

        if not np.any(inside):
            continue

        alpha_field[
            inside,
            j
        ] = np.interp(
            y_grid[inside],
            y_unique,
            alpha_unique
        )

    rgba = np.array(
        to_rgba(color)
    )

    image = np.empty(
        (
            n_y,
            n_x,
            4
        ),
        dtype=np.float32
    )

    image[:, :, 0] = rgba[0]
    image[:, :, 1] = rgba[1]
    image[:, :, 2] = rgba[2]
    image[:, :, 3] = alpha_field

    # =====================================================
    # DRAW SMOOTH Q10 COLLAR
    # =====================================================

    ax.imshow(
        image,
        origin="lower",
        aspect="auto",
        interpolation="bilinear",
        extent=[
            x_fine[0],
            x_fine[-1],
            y_axis_min,
            y_axis_max
        ],
        zorder=zorder
    )

    # =====================================================
    # EMPHASISE TOP AND BOTTOM OF COLLARED BAND
    # =====================================================

    COLLAR_BOUNDARY_LINEWIDTH = 0.55
    COLLAR_BOUNDARY_ALPHA = 0.0

    ax.plot(
        x_fine,
        y_fine[0],
        color=color,
        linestyle="-",
        linewidth=COLLAR_BOUNDARY_LINEWIDTH,
        alpha=COLLAR_BOUNDARY_ALPHA,
        zorder=zorder + 0.25
    )

    ax.plot(
        x_fine,
        y_fine[-1],
        color=color,
        linestyle="-",
        linewidth=COLLAR_BOUNDARY_LINEWIDTH,
        alpha=COLLAR_BOUNDARY_ALPHA,
        zorder=zorder + 0.25
    )


