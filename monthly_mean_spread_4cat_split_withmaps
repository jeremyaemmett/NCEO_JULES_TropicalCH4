def load_map(
    suite,
    month
):

    path = get_map_file(
        suite,
        month
    )

    data = np.loadtxt(
        path
    )

    data = np.asarray(
        data,
        dtype=float
    )

    if data.ndim != 2:

        raise ValueError(
            f"Expected a 2-D map from:\n{path}\n"
            f"Got shape: {data.shape}"
        )

    print(
        f"  Map shape: {data.shape}"
    )

    return data, path


# =========================================================
# CONSTRUCT AND CROP MAP GRID
# =========================================================

def construct_map_grid(
    data,
    full_lat2d,
    full_lon2d
):

    nlat_map, nlon_map = data.shape

    nlat_full, nlon_full = full_lat2d.shape

    print(
        "  Full grid dimensions:",
        full_lat2d.shape
    )

    if nlon_map != nlon_full:

        raise ValueError(
            "\nMAP LONGITUDE DIMENSION MISMATCH\n"
            f"Map longitude dimension : {nlon_map}\n"
            f"Full grid longitude dim : {nlon_full}\n"
        )

    full_lats = np.asarray(
        full_lat2d[:, 0],
        dtype=float
    )

    full_lons = np.asarray(
        full_lon2d[0, :],
        dtype=float
    )

    lat_mask = (
        (full_lats >= MAP_LAT_MIN)
        &
        (full_lats <= MAP_LAT_MAX)
    )

    matching_rows = np.where(
        lat_mask
    )[0]

    if len(matching_rows) == nlat_map:

        row_indices = matching_rows

    else:

        target_centre = (
            MAP_LAT_MIN
            + MAP_LAT_MAX
        ) / 2.0

        candidate_starts = []

        for start in range(
            0,
            nlat_full - nlat_map + 1
        ):

            rows = np.arange(
                start,
                start + nlat_map
            )

            lats = full_lats[rows]

            centre = (
                lats.min()
                + lats.max()
            ) / 2.0

            lower_distance = abs(
                lats.min()
                - MAP_LAT_MIN
            )

            upper_distance = abs(
                lats.max()
                - MAP_LAT_MAX
            )

            centre_distance = abs(
                centre
                - target_centre
            )

            score = (
                lower_distance
                + upper_distance
                + centre_distance
            )

            candidate_starts.append(
                (
                    score,
                    rows
                )
            )

        candidate_starts.sort(
            key=lambda item: item[0]
        )

        row_indices = candidate_starts[0][1]

    lat2d_full = full_lat2d[
        row_indices,
        :
    ]

    lon2d_full = full_lon2d[
        row_indices,
        :
    ]

    data_lat = data[
        :,
        :
    ]

    if data_lat.shape[0] != len(row_indices):

        raise ValueError(
            "\nMAP LATITUDE DIMENSION MISMATCH\n"
            f"Map latitude dimension : {data_lat.shape[0]}\n"
            f"Selected grid rows     : {len(row_indices)}\n"
        )

    lon_plot_1d = (
        (
            full_lons
            + 180.0
        )
        % 360.0
    ) - 180.0

    lon_mask = (
        (lon_plot_1d >= MAP_LON_MIN - 1e-10)
        &
        (lon_plot_1d <= MAP_LON_MAX + 1e-10)
    )

    lon_indices = np.where(
        lon_mask
    )[0]

    if len(lon_indices) == 0:

        raise RuntimeError(
            "\nNO LONGITUDES FOUND IN REQUESTED RANGE\n"
            f"Requested: {MAP_LON_MIN} to {MAP_LON_MAX}\n"
            f"Original longitude: "
            f"{full_lons.min()} to "
            f"{full_lons.max()}\n"
        )

    lon_indices = lon_indices[
        np.argsort(
            lon_plot_1d[
                lon_indices
            ]
        )
    ]

    cropped_lons = lon_plot_1d[
        lon_indices
    ]

    cropped_data = data_lat[
        :,
        lon_indices
    ]

    cropped_lat2d = lat2d_full[
        :,
        lon_indices
    ]

    cropped_lon2d = np.broadcast_to(
        cropped_lons[np.newaxis, :],
        cropped_lat2d.shape
    )

    cropped_lon2d = np.asarray(
        cropped_lon2d
    )

    if cropped_data.shape != cropped_lat2d.shape:

        raise RuntimeError(
            "\nFINAL MAP SHAPE MISMATCH\n"
            f"Data shape : {cropped_data.shape}\n"
            f"Lat shape  : {cropped_lat2d.shape}\n"
        )

    if cropped_data.shape != cropped_lon2d.shape:

        raise RuntimeError(
            "\nFINAL MAP LONGITUDE SHAPE MISMATCH\n"
            f"Data shape : {cropped_data.shape}\n"
            f"Lon shape  : {cropped_lon2d.shape}\n"
        )

    print(
        "  CROPPED MAP GRID:"
    )

    print(
        f"    Shape: {cropped_data.shape}"
    )

    print(
        f"    Latitude: "
        f"{cropped_lat2d.min():.3f} to "
        f"{cropped_lat2d.max():.3f}"
    )

    print(
        f"    Longitude: "
        f"{cropped_lon2d.min():.3f} to "
        f"{cropped_lon2d.max():.3f}"
    )

    print(
        f"    Longitude columns retained: "
        f"{len(lon_indices)} / {nlon_map}"
    )

    if (
        cropped_lon2d.min() < MAP_LON_MIN - 1e-8
        or
        cropped_lon2d.max() > MAP_LON_MAX + 1e-8
    ):

        raise RuntimeError(
            "\nLONGITUDE CROPPING FAILED\n"
            f"Requested: {MAP_LON_MIN} to {MAP_LON_MAX}\n"
            f"Got: "
            f"{cropped_lon2d.min()} to "
            f"{cropped_lon2d.max()}"
        )

    return (
        cropped_data,
        cropped_lat2d,
        cropped_lon2d
    )


