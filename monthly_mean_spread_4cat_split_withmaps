# =========================================================
# ABSOLUTE MAP RGBA
# =========================================================

def make_absolute_rgba(data):

    norm = mcolors.Normalize(
        vmin=MAP_VMIN,
        vmax=MAP_VMAX,
        clip=False
    )

    cmap = plt.get_cmap(
        MAP_CMAP
    )

    rgba = cmap(
        norm(data)
    )

    alpha = norm(data)

    alpha = np.clip(
        alpha,
        0.0,
        1.0
    )

    alpha = np.nan_to_num(
        alpha,
        nan=0.0,
        posinf=1.0,
        neginf=0.0
    )

    rgba[..., -1] = alpha

    return (
        rgba,
        norm,
        cmap
    )


# =========================================================
# OCEAN COLOUR / Q10 SHADING
# =========================================================

def add_substrate_q10_ocean(
    ax,
    substrate,
    q10_code=SELECTED_Q10_CODE
):

    # =====================================================
    # HARD EXCLUSION
    # =====================================================

    if str(q10_code) in EXCLUDED_Q10_CODES:

        raise ValueError(
            f"Q10 code {q10_code} is excluded."
        )

    if str(q10_code) not in q10_alpha:

        raise ValueError(
            f"No Q10 alpha defined for "
            f"Q10 code {q10_code}"
        )

    substrate_color = color_map[
        substrate
    ]

    alpha = q10_alpha[
        str(q10_code)
    ]

    substrate_rgb = np.array(
        to_rgba(
            substrate_color
        )[:3],
        dtype=float
    )

    white_rgb = np.ones(
        3,
        dtype=float
    )

    washed_rgb = (
        alpha * substrate_rgb
        +
        (1.0 - alpha) * white_rgb
    )

    washed_color = (
        washed_rgb[0],
        washed_rgb[1],
        washed_rgb[2],
        1.0
    )

    print(
        f"  Ocean colour: "
        f"substrate={substrate_labels[substrate]}, "
        f"Q10={q10_labels[str(q10_code)]}, "
        f"alpha={alpha:.2f}, "
        f"RGB="
        f"({washed_rgb[0]:.3f}, "
        f"{washed_rgb[1]:.3f}, "
        f"{washed_rgb[2]:.3f})"
    )

    ax.add_feature(
        cfeature.OCEAN,
        facecolor=washed_color,
        edgecolor="none",
        zorder=0,
        alpha=1.0
    )


