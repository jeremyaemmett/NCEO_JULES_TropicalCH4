def configure_map_axis(
    ax,
    month,
):
    """
    Configure one seasonal map axis.
    """

    ax.set_title(
        month,
        fontsize=11,
        fontstyle="italic",
        pad=8,
        alpha=0.7,
        x=0.07, y=0.29,
        zorder = 5
    )

    ax.set_extent(
        [
            LON_MIN,
            LON_MAX,
            LAT_MIN,
            LAT_MAX,
        ],
        crs=ccrs.PlateCarree(),
    )

    try:
        ax.spines["geo"].set_visible(
            False
        )
    except KeyError:
        pass

    ax.patch.set_edgecolor(
        "none"
    )

    ax.patch.set_linewidth(
        0
    )

    add_map_underlay(
        ax
    )


# =========================================================
# ABSOLUTE RGBA CREATION
# =========================================================

def make_absolute_rgba(
    data,
    variable_name,
    variable_global_min,
    variable_global_max,
    cmap_name,
):
    """
    Create RGBA data for absolute mode.

    Colour:
        inferno

    Alpha:
        normalised data value
    """

    vmin = variable_global_min
    vmax = variable_global_max

    if variable_name == "fch4_wetl":

        vmin = ABSOLUTE_VMIN
        vmax = ABSOLUTE_VMAX

    norm = mcolors.Normalize(
        vmin=vmin,
        vmax=vmax,
        clip=False,
    )

    cmap = plt.get_cmap(
        cmap_name
    )

    rgba = cmap(
        norm(data)
    )

    alpha = norm(
        data
    )

    alpha = np.clip(
        alpha,
        0.0,
        1.0,
    )

    alpha = np.nan_to_num(
        alpha,
        nan=0.0,
        posinf=1.0,
        neginf=0.0,
    )

    rgba[..., -1] = alpha

    return (
        rgba,
        norm,
        cmap,
    )


# =========================================================
# DIFFERENCE RGBA CREATION
# =========================================================

def make_difference_rgba(
    data,
    abs_max,
    cmap,
):
    """
    Create RGBA data for difference mode.

    Negative differences:
        blue

    Zero:
        beige / transparent

    Positive differences:
        red

    The same normalisation and alpha function are used
    by the difference colourbar.
    """

    norm = mcolors.Normalize(
        vmin=-abs_max,
        vmax=abs_max,
        clip=True,
    )

    # -----------------------------------------------------
    # Map difference to colour.
    # -----------------------------------------------------

    rgba = cmap(
        norm(data)
    )

    # -----------------------------------------------------
    # Alpha based on absolute difference.
    #
    # Zero:
    #     completely transparent
    #
    # Maximum:
    #     completely opaque
    # -----------------------------------------------------

    alpha = (
        np.abs(data)
        / abs_max
    )

    alpha = np.clip(
        alpha,
        0.0,
        1.0,
    )

    alpha = (
        alpha
        ** DIFFERENCE_ALPHA_POWER
    )

    alpha = np.nan_to_num(
        alpha,
        nan=0.0,
        posinf=1.0,
        neginf=0.0,
    )

    rgba[..., -1] = alpha

    return (
        rgba,
        norm,
        cmap,
    )


# =========================================================
# ABSOLUTE COLORBAR
# =========================================================

def add_absolute_colorbar(
    fig,
    variable_name,
    variable_unit,
    variable_global_min,
    variable_global_max,
):
    """
    Add the absolute-mode vertical colourbar.
    """

    vmin = variable_global_min
    vmax = variable_global_max

    if variable_name == "fch4_wetl":

        vmin = ABSOLUTE_VMIN
        vmax = ABSOLUTE_VMAX

    norm = mcolors.Normalize(
        vmin=vmin,
        vmax=vmax,
    )

    rgba_cmap = plt.get_cmap(
        ABSOLUTE_CMAP
    )

    N = 256

    values = np.linspace(
        0.0,
        1.0,
        N,
    )

    colors = rgba_cmap(
        values
    )

    colors[:, -1] = values

    alpha_cmap = mcolors.ListedColormap(
        colors
    )

    sm = cm.ScalarMappable(
        cmap=alpha_cmap,
        norm=norm,
    )

    sm.set_array(
        []
    )

    cb_ax = fig.add_axes(
        COLORBAR_POS
    )

    cb_ax.add_patch(
        plt.Rectangle(
            (0, 0),
            1,
            1,
            transform=cb_ax.transAxes,
            facecolor="#f5e6c8",
            edgecolor="none",
            zorder=0,
            alpha=1.0,
        )
    )

    cb = fig.colorbar(
        sm,
        cax=cb_ax,
        orientation="vertical",
    )

    cb.set_label(
        dataOPS.cleanup_exponents(
            variable_unit
        ),
        fontsize=11,
    )

    cb.ax.tick_params(
        labelsize=10
    )

    GRAY = "black"
    ALPHA = 0.8

    cb.outline.set_edgecolor(
        GRAY
    )

    cb.outline.set_alpha(
        ALPHA
    )

    cb.outline.set_linewidth(
        0.8
    )

    cb.ax.tick_params(
        color=GRAY,
        labelcolor=GRAY,
        labelsize=10,
        width=0.8,
    )

    for tick_label in cb.ax.get_yticklabels():

        tick_label.set_alpha(
            ALPHA
        )

    cb.ax.yaxis.label.set_color(
        GRAY
    )

    cb.ax.yaxis.label.set_alpha(
        ALPHA
    )

    return cb


# =========================================================
# DIFFERENCE COLORBAR
# =========================================================

def add_difference_colorbar(
    fig,
    variable_unit,
    abs_max,
):
    """
    Add the difference colourbar.

    This uses exactly the same custom colormap,
    normalisation and alpha function as the difference map.
    """

    norm = mcolors.Normalize(
        vmin=-abs_max,
        vmax=abs_max,
        clip=True,
    )

    cmap = DIFFERENCE_CMAP

    # -----------------------------------------------------
    # Build colourbar values.
    # -----------------------------------------------------

    N = 256

    values = np.linspace(
        -1.0,
        1.0,
        N,
    )

    cmap_values = (
        values + 1.0
    ) / 2.0

    colors = cmap(
        cmap_values
    )

    # -----------------------------------------------------
    # Same alpha function as the map.
    # -----------------------------------------------------

    alpha = np.abs(
        values
    )

    alpha = np.clip(
        alpha,
        0.0,
        1.0,
    )

    alpha = (
        alpha
        ** DIFFERENCE_ALPHA_POWER
    )

    colors[:, -1] = alpha

    alpha_cmap = mcolors.ListedColormap(
        colors
    )

    sm = cm.ScalarMappable(
        cmap=alpha_cmap,
        norm=norm,
    )

    sm.set_array(
        []
    )

    # -----------------------------------------------------
    # Colourbar axis.
    # -----------------------------------------------------

    cb_ax = fig.add_axes(
        COLORBAR_POS
    )

    cb_ax.set_facecolor(
        "#f5e6c8"
    )

    cb = fig.colorbar(
        sm,
        cax=cb_ax,
        orientation="vertical",
    )

    cb.set_label(
        dataOPS.cleanup_exponents(
            variable_unit
        ),
        fontsize=11,
    )

    cb.ax.tick_params(
        labelsize=10
    )

    GRAY = "black"
    ALPHA = 0.8

    cb.outline.set_edgecolor(
        GRAY
    )

    cb.outline.set_alpha(
        ALPHA
    )

    cb.outline.set_linewidth(
        0.8
    )

    cb.ax.tick_params(
        color=GRAY,
        labelcolor=GRAY,
        labelsize=10,
        width=0.8,
    )

    for tick_label in cb.ax.get_yticklabels():

        tick_label.set_alpha(
            ALPHA
        )

    cb.ax.yaxis.label.set_color(
        GRAY
    )

    cb.ax.yaxis.label.set_alpha(
        ALPHA
    )

    return cb


# =========================================================
# MAKE ABSOLUTE PANEL
# =========================================================

def make_absolute_panel(
    suite,
    lat2d,
    lon2d,
    variable_unit,
    variable_global_min,
    variable_global_max,
):
    """
    Make one complete absolute seasonal panel.
    """

    print(
        "\n"
        + "=" * 60
    )

    print(
        "ABSOLUTE PANEL"
    )

    print(
        f"Suite code: {decode_suite(suite)['code']}"
    )

    print(
        f"Configuration: {suite_title(suite)}"
    )

    print(
        "=" * 60
    )

    fig, axes = create_panel_figure()

    positions = {
        "Mar": (0, 0),
        "Jun": (0, 1),
        "Sep": (1, 0),
        "Dec": (1, 1),
    }

    for month in months:

        row, col = positions[
            month
        ]

        ax = axes[
            row,
            col
        ]

        configure_map_axis(
            ax,
            month,
        )

        data = load_map(
            suite,
            month,
            lat2d,
        )

        rgba, _, _ = make_absolute_rgba(
            data,
            variable,
            variable_global_min,
            variable_global_max,
            ABSOLUTE_CMAP,
        )

        ax.pcolormesh(
            lon2d,
            lat2d,
            rgba,
            shading="auto",
            transform=ccrs.PlateCarree(),
            linewidth=0,
            edgecolors="none",
            antialiased=False,
            zorder=2,
        )

        add_final_ocean(
            ax
        )

        add_coastline(
            ax
        )

    # =====================================================
    # OVERALL FIGURE TITLE
    # =====================================================

    fig.text(
        0.025,
        0.985,
        suite_title(suite),
        ha="left",
        va="top",
        fontsize=13,
        fontweight="bold",
    )

    # =====================================================
    # COLORBAR
    # =====================================================

    add_absolute_colorbar(
        fig,
        variable,
        variable_unit,
        variable_global_min,
        variable_global_max,
    )

    # =====================================================
    # OUTPUT
    # =====================================================

    output_file = (
        base_path
        / (
            f"{suite}_"
