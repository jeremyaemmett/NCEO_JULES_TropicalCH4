def get_map_directory(suite):
    """
    Directory containing the seasonal *_map.txt files.
    """

    return (
        base_path
        / suite
        / "plots"
        / domain
        / "output"
        / scale_type
        / variable
    )


def get_map_file(suite, month):
    """
    Return the *_map.txt file for a given suite and month.
    """

    directory = get_map_directory(
        suite
    )

    return find_file(
        directory,
        f"{month}_map.txt"
    )


# =========================================================
# LOAD ONE MAP
# =========================================================

def load_map(
    suite,
    month,
    lat2d,
):
    """
    Load a seasonal map from text.
    """

    path = get_map_file(
        suite,
        month
    )

    print(
        f"Reading {month} / {suite}: {path}"
    )

    data = np.loadtxt(
        path
    )

    if data.shape != lat2d.shape:

        raise ValueError(
            f"\nShape mismatch for:\n"
            f"{path}\n"
            f"Map data shape : {data.shape}\n"
            f"Grid shape     : {lat2d.shape}\n"
        )

    return data


