}


DYNAMICS_LABELS = {
    "0": "Competitive",
    "1": "Non-competitive",
}


def decode_suite(suite):
    """
    Decode a JULES suite name into the four experimental
    parameter categories encoded by its four-digit suffix.
    """

    suite = str(suite)

    if "_" not in suite:
        raise ValueError(
            f"Cannot decode suite {suite!r}: "
            "expected a four-digit suffix after '_'."
        )

    code = suite.split("_")[-1]

    if len(code) != 4 or not code.isdigit():
        raise ValueError(
            f"Cannot decode suite {suite!r}: "
            f"suffix {code!r} is not four digits."
        )

    substrate_code = code[0]
    q10_code = code[1]
    soil_code = code[2]
    dynamics_code = code[3]

    if substrate_code not in SUBSTRATE_LABELS:
        raise ValueError(
            f"Unknown substrate code {substrate_code!r} "
            f"in suite {suite!r}."
        )

    if q10_code not in Q10_LABELS:
        raise ValueError(
            f"Unknown Q10 code {q10_code!r} "
            f"in suite {suite!r}."
        )

    if soil_code not in SOIL_LABELS:
        raise ValueError(
            f"Unknown soil-map code {soil_code!r} "
            f"in suite {suite!r}."
        )

    if dynamics_code not in DYNAMICS_LABELS:
        raise ValueError(
            f"Unknown dynamics code {dynamics_code!r} "
            f"in suite {suite!r}."
        )

    return {
        "suite": suite,
        "code": code,
        "substrate_code": substrate_code,
        "q10_code": q10_code,
        "soil_code": soil_code,
        "dynamics_code": dynamics_code,
        "substrate": SUBSTRATE_LABELS[
            substrate_code
        ],
        "q10": Q10_LABELS[
            q10_code
        ],
        "soil": SOIL_LABELS[
            soil_code
        ],
        "dynamics": DYNAMICS_LABELS[
            dynamics_code
        ],
    }


def suite_description(suite):
    """
    Return a concise human-readable description of a suite.
    """

    info = decode_suite(suite)

    return (
        f"{info['substrate']} | "
        f"Q10 = {info['q10']} | "
        f"{info['soil']} | "
        f"{info['dynamics']}"
    )


def suite_title(suite):
    """
    Return the overall figure title for one suite.
    """

    return suite_description(suite)


def difference_title(
    suite_a,
    suite_b,
):
    """
    Return a human-readable description of the difference
    between two encoded suites.
    """

    description_a = suite_description(
        suite_a
    )

    description_b = suite_description(
        suite_b
    )

    return (
        f"{description_a}  −  {description_b}"
    )


