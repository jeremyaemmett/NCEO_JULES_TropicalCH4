def create_panel_figure():
    """
    Create the common 2x2 figure geometry.
    """

    fig, axes = plt.subplots(
        2,
        2,
        figsize=FIGSIZE,
        subplot_kw={
            "projection": ccrs.PlateCarree(
                central_longitude=25
            )
        },
        squeeze=False,
    )

    fig.subplots_adjust(
        **SUBPLOT_ADJUST
    )

    fig.patch.set_facecolor(
        "white"
    )

    return fig, axes


