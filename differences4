# =========================================================
# MAKE DIFFERENCE PANEL
# =========================================================

def make_difference_panel(
    lat2d,
    lon2d,
    variable_unit,
    difference_data,
):
    """
    Make the difference seasonal panel.

    Difference is:

        suites[0] - suites[1]

    Scale is fixed at +/- 0.25.
    """

    print(
        "\n"
        + "=" * 60
    )

    print(
        "DIFFERENCE PANEL"
    )

    print(
        f"{suites[0]} - {suites[1]}"
    )

    print(
        f"{suite_description(suites[0])}"
    )

    print(
        "minus"
    )

    print(
        f"{suite_description(suites[1])}"
    )

    print(
        "=" * 60
    )

    # =====================================================
    # FIXED GLOBAL DIFFERENCE SCALE
    # =====================================================

    abs_max = 0.25

    if not np.isfinite(
        abs_max
    ):

        raise ValueError(
            "No finite difference data were found."
        )

    if abs_max == 0:

        raise ValueError(
            "All difference data are zero. "
            "A non-zero colour scale is required."
        )

    print(
        "\nDifference colour scale:"
    )

    print(
        f"  Minimum = {-abs_max}"
    )

    print(
        f"  Maximum = {abs_max}"
    )

    print(
        "\nDifference alpha settings:"
    )

    print(
        f"  Alpha max   = "
        f"{DIFFERENCE_ALPHA_MAX}"
    )

    print(
        f"  Alpha power = "
        f"{DIFFERENCE_ALPHA_POWER}"
    )

    # =====================================================
    # FIGURE
    # =====================================================

    fig, axes = create_panel_figure()

    positions = {
        "Mar": (0, 0),
        "Jun": (0, 1),
        "Sep": (1, 0),
        "Dec": (1, 1),
    }

    for m, month in enumerate(
        months
    ):

        row, col = positions[
            month
        ]

        ax = axes[
            row,
            col
        ]

        configure_map_axis(
            ax,
            month,
        )

        data = difference_data[
            m
        ]

        # -------------------------------------------------
        # Create RGBA.
        # -------------------------------------------------

        rgba, _, _ = make_difference_rgba(
            data,
            abs_max,
            DIFFERENCE_CMAP,
        )

        # -------------------------------------------------
        # Plot.
        # -------------------------------------------------

        ax.pcolormesh(
            lon2d,
            lat2d,
            rgba,
            shading="auto",
            transform=ccrs.PlateCarree(),
            linewidth=0,
            edgecolors="none",
            antialiased=False,
            zorder=2,
        )

        # -------------------------------------------------
        # Final ocean.
        # -------------------------------------------------

        add_final_ocean(
            ax
        )

        # -------------------------------------------------
        # Coastline.
        # -------------------------------------------------

        add_coastline(
            ax
        )

    # =====================================================
    # OVERALL FIGURE TITLE
    # =====================================================

    fig.text(
        0.025,
        0.985,
        difference_title(
            suites[0],
            suites[1],
        ),
        ha="left",
        va="top",
        fontsize=11.5,
        fontweight="bold",
    )

    # =====================================================
    # DIFFERENCE COLORBAR
    # =====================================================

    add_difference_colorbar(
        fig,
        variable_unit,
        abs_max,
    )

    # =====================================================
    # OUTPUT
    # =====================================================

    output_file = (
        Path(
            "/Users/jae35/Desktop/JULES_test_data"
        )
        / (
            f"differences3_"
            f"{domain}_"
            f"{scale_type}_"
            f"lat{LAT_MIN}_{LAT_MAX}.png"
        )
    )

    fig.savefig(
        output_file,
        dpi=300,
        bbox_inches="tight",
        facecolor="white",
    )

    print(
        f"\nSaved difference panel:\n"
        f"{output_file}\n"
    )

    return fig


